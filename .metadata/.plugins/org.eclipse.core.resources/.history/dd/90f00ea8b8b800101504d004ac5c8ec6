        // 1️⃣ 先確認購物車存在
        Cart cart = cartRepository.findById(cartId)
                .orElseThrow(() -> new RuntimeException("Cart not found with id: " + cartId));

        // 2️⃣ 綁定購物車關聯
        cartItem.setCart(cart);

        // 3️⃣ 儲存購物車項目
        cartItemRepository.save(cartItem);
    }

