<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>商品詳細頁</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- 自訂 CSS -->
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/style.css">
</head>
<body>
<div class="container mt-4">

    <!-- 回到商品列表 -->
    <a href="${pageContext.request.contextPath}/products/list" class="btn btn-secondary mb-3">← 回商品列表</a>

    <!-- 商品詳細卡片 -->
    <div class="row">
        <div class="col-md-6">
            <!-- 商品圖片 -->
            <img src="${pageContext.request.contextPath}/${product.imagePath}" class="img-fluid" alt="${product.name}">
        </div>
        <div class="col-md-6">
            <h2>${product.name}</h2>
            <p>價格: NT$ ${product.price}</p>
            <p>庫存: ${product.stock}</p>
            <p>描述: ${product.description}</p>

            <!-- 加入購物車表單 -->
            <form action="${pageContext.request.contextPath}/cart/add" method="post">
                <input type="hidden" name="prodId" value="${product.prodId}">
                <label>數量:</label>
                <input type="number" name="quantity" value="1" min="1" max="${product.stock}" class="form-control mb-2" style="width:100px;">
                <button type="submit" class="btn btn-warning">加入購物車</button>
            </form>

            <!-- 管理員刪除按鈕 -->
            <c:if test="${sessionScope.role == 'ROLE_ADMIN'}">
                <a href="${pageContext.request.contextPath}/products/admin/delete/${product.prodId}" 
                   class="btn btn-danger mt-2"
                   onclick="return confirm('確定要刪除這個商品嗎？');">刪除商品</a>
            </c:if>
        </div>
    </div>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- 自訂 JS -->
<script src="${pageContext.request.contextPath}/resources/js/script.js"></script>
</body>
</html>
