<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Online Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .product-card {
            border-radius: 15px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }
        .product-img {
            height: 200px;
            object-fit: cover;
            border-radius: 15px 15px 0 0;
        }
    </style>
</head>
<body>
    <!-- 導覽列 -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">🏬 My Online Store</a>
            <a th:href="@{/products/add}" class="btn btn-success ms-auto">➕ Add Product</a>
        </div>
    </nav>

    <!-- 商品卡片列表 -->
    <div class="container mt-5">
        <h2 class="text-center mb-4">Our Products</h2>
        <div class="row g-4">
            <!-- 產品卡片迴圈 -->
            <div class="col-md-4" th:each="product : ${products}">
                <div class="card product-card h-100">
                    <!-- 商品圖片 -->
                    <img th:src="@{resources/img/1.png}" alt="Product Image" class="card-img-top product-img">
                    <!-- 若你的 Product 實體中有欄位 imagePath，可改為 -->
                    <!-- <img th:src="@{'/img/' + ${product.imagePath}}" alt="Product Image" class="card-img-top product-img"> -->

                    <div class="card-body text-center">
                        <h5 class="card-title" th:text="${product.prod_name}">Product Name</h5>
                        <p class="text-muted mb-1" th:text="'類別：' + ${product.prod_type}">Type</p>
                        <p class="text-muted mb-1" th:text="'系列：' + ${product.prod_line}">Line</p>
                        <p class="fw-bold text-primary fs-5" th:text="'NT$ ' + ${product.pro_price}">NT$ 999</p>
                    </div>
                    <div class="card-footer text-center bg-white border-0 pb-3">
                        <a th:href="@{/product-detail(prod_num=${product.prod_num})}" class="btn btn-primary btn-sm me-2">View</a>
                        <a th:href="@{/products/edit/{id}(id=${product.id})}" class="btn btn-warning btn-sm me-2">Edit</a>
                        <a th:href="@{/products/delete/{id}(id=${product.id})}" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
