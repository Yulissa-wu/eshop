<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Add New product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-4">
    <h1>Add New product</h1>

    <!-- 表單提交到 /product/save -->
    <form th:action="@{/product/save}" th:object="${product}" method="post">
        <div class="mb-3">
            <label for="prod_name" class="form-label">Name</label>
            <input type="prod_name" th:field="*{prod_name}" class="form-control" id="prod_name" placeholder="Enter prod_name" required>
        </div>

        <div class="mb-3">
            <label for="prod_type" class="form-label">Email</label>
            <input type="prod_type" th:field="*{prod_type}" class="form-control" id="prod_type" placeholder="Enter prod_type" required>
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <a th:href="@{/product}" class="btn btn-secondary">Cancel</a>
    </form>
</div>
</body>
</html>
