<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Add New product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-4">
    <h1>Add New product</h1>

    <!-- 表單提交到 /product/save -->
    <form th:action="@{/products/save}" th:object="${product}" method="post">
        <div class="mb-3">
            <label for="prod_name" class="form-label">prod_name</label>
            <input type="text" th:field="*{prod_name}" class="form-control" id="prod_name" placeholder="Enter prod_name" required>
        </div>

        <div class="mb-3">
            <label for="prod_type" class="form-label">prod_type</label>
            <input type="text" th:field="*{prod_type}" class="form-control" id="prod_type" placeholder="Enter prod_type" required>
        </div>
        
        <div class="mb-3">
            <label for="prod_line" class="form-label">prod_line</label>
            <input type="text" th:field="*{prod_line}" class="form-control" id="prod_line" placeholder="Enter prod_line" required>
        </div>

        <div class="mb-3">
            <label for="pro_price" class="form-label">pro_price</label>
            <input type="text" th:field="*{pro_price}" class="form-control" id="pro_price" placeholder="Enter pro_price" required>
        </div>
        
        <div class="mb-3">
            <label class="form-label">上傳圖片：</label>
            <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*" onchange="previewImage(event)">
        </div>

        <div class="mb-3" id="previewContainer" style="display: none;">
            <img id="previewImage" src="" alt="圖片預覽" class="img-thumbnail mb-2" style="max-width: 200px;">
            <br>
            <button type="button" class="btn btn-danger btn-sm" onclick="removeImage()">刪除圖片</button>
        </div>
        
        <button type="submit" class="btn btn-success">Save</button>
        <a th:href="@{/product}" class="btn btn-secondary">Cancel</a>
    </form>
</div>
</body>
</html>
