    /**
     * 刪除商品圖片檔案
     * @param productId 商品ID
     */
    private void deleteProductImages(int productId) {
        try {
            String selectSQL = "SELECT image_path FROM product_images WHERE product_id = ?";
            try (PreparedStatement pstmt = connection.prepareStatement(selectSQL)) {
                pstmt.setInt(1, productId);
                try (ResultSet rs = pstmt.executeQuery()) {
                    while (rs.next()) {
                        String imagePath = rs.getString("image_path");
                        try {
                            Files.deleteIfExists(Paths.get(imagePath));
                            logger.info("刪除圖片檔案: " + imagePath);
                        } catch (IOException e) {
                            logger.warning("刪除圖片檔案失敗: " + imagePath + " - " + e.getMessage());
                        }
                    }
                }
            }
        } catch (SQLException e) {
            logger.severe("查詢商品圖片失敗: " + e.getMessage());
        }
    }
    
