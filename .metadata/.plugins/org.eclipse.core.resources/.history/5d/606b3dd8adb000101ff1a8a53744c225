    /**
     * 獲取所有分類
     * @return 分類列表
     */
    public Map<String, Object> getCategories() {
        // 記錄獲取分類開始日誌
        logger.info("開始處理獲取分類列表請求");
        
        Map<String, Object> result = new HashMap<>();
        List<Map<String, Object>> categories = new ArrayList<>();
        
        try {
            String selectSQL = "SELECT * FROM categories WHERE is_active = TRUE ORDER BY sort_order ASC, category_name ASC";
            try (PreparedStatement pstmt = connection.prepareStatement(selectSQL);
                 ResultSet rs = pstmt.executeQuery()) {
                
                while (rs.next()) {
                    Map<String, Object> category = new HashMap<>();
                    category.put("category_id", rs.getInt("category_id"));
                    category.put("category_name", rs.getString("category_name"));
                    category.put("description", rs.getString("description"));
                    category.put("image_path", rs.getString("image_path"));
                    category.put("parent_id", rs.getInt("parent_id"));
                    category.put("sort_order", rs.getInt("sort_order"));
                    category.put("created_at", rs.getTimestamp("created_at"));
                    category.put("updated_at", rs.getTimestamp("updated_at"));
                    
                    categories.add(category);
                }
            }
            
            result.put("success", true);
            result.put("categories", categories);
            logger.info("分類列表獲取成功 - 返回 " + categories.size() + " 個分類");
            
        } catch (SQLException e) {
            // 記錄資料庫錯誤日誌
            logger.severe("獲取分類列表過程中發生資料庫錯誤: " + e.getMessage());
            result.put("success", false);
            result.put("message", "系統錯誤，請稍後再試");
        }
        
        return result;
    }
    
