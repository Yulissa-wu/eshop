    /**
     * 新增商品
     * @param productData 商品資料
     * @param createdBy 創建者ID
     * @return 新增結果
     */
    public Map<String, Object> addProduct(Map<String, Object> productData, int createdBy) {
        // 記錄新增商品開始日誌
        logger.info("開始處理新增商品請求 - 商品名稱: " + productData.get("product_name") + ", 創建者: " + createdBy);
        
        Map<String, Object> result = new HashMap<>();
        
        try {
            // 驗證商品資料
            if (!validateProductData(productData)) {
                result.put("success", false);
                result.put("message", "商品資料格式不正確");
                logger.warning("新增商品失敗 - 資料格式不正確");
                return result;
            }
            
            // 插入商品到資料庫
            String insertSQL = "INSERT INTO products (product_name, description, price, stock_quantity, category_id, main_image, status, weight, dimensions, brand, sku, tags, is_featured, sort_order, created_by) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";
            try (PreparedStatement pstmt = connection.prepareStatement(insertSQL, Statement.RETURN_GENERATED_KEYS)) {
                pstmt.setString(1, (String) productData.get("product_name"));
                pstmt.setString(2, (String) productData.get("description"));
                pstmt.setBigDecimal(3, new java.math.BigDecimal(productData.get("price").toString()));
                pstmt.setInt(4, Integer.parseInt(productData.get("stock_quantity").toString()));
                pstmt.setInt(5, Integer.parseInt(productData.get("category_id").toString()));
                pstmt.setString(6, (String) productData.get("main_image"));
                pstmt.setString(7, (String) productData.getOrDefault("status", "draft"));
                pstmt.setBigDecimal(8, productData.get("weight") != null ? new java.math.BigDecimal(productData.get("weight").toString()) : null);
                pstmt.setString(9, (String) productData.get("dimensions"));
                pstmt.setString(10, (String) productData.get("brand"));
                pstmt.setString(11, (String) productData.get("sku"));
                pstmt.setString(12, (String) productData.get("tags"));
                pstmt.setBoolean(13, Boolean.parseBoolean(productData.getOrDefault("is_featured", "false").toString()));
                pstmt.setInt(14, Integer.parseInt(productData.getOrDefault("sort_order", "0").toString()));
                pstmt.setInt(15, createdBy);
                
                int rowsAffected = pstmt.executeUpdate();
                
                if (rowsAffected > 0) {
                    // 獲取新插入的商品ID
                    try (ResultSet generatedKeys = pstmt.getGeneratedKeys()) {
                        if (generatedKeys.next()) {
                            int productId = generatedKeys.getInt(1);
                            result.put("success", true);
                            result.put("message", "商品新增成功");
                            result.put("product_id", productId);
                            logger.info("商品新增成功 - 商品ID: " + productId + ", 商品名稱: " + productData.get("product_name"));
                        }
                    }
                } else {
                    result.put("success", false);
                    result.put("message", "商品新增失敗");
                    logger.severe("商品新增失敗 - 資料庫插入失敗");
                }
            }
            
        } catch (SQLException e) {
            // 記錄資料庫錯誤日誌
            logger.severe("新增商品過程中發生資料庫錯誤: " + e.getMessage());
            result.put("success", false);
            result.put("message", "系統錯誤，請稍後再試");
        } catch (Exception e) {
            // 記錄其他錯誤日誌
            logger.severe("新增商品過程中發生錯誤: " + e.getMessage());
            result.put("success", false);
            result.put("message", "系統錯誤，請稍後再試");
        }
        
        return result;
    }
    
    /**
     * 刪除商品
     * @param productId 商品ID
     * @param userId 操作者ID
     * @return 刪除結果
     */
    public Map<String, Object> deleteProduct(int productId, int userId) {
        // 記錄刪除商品開始日誌
        logger.info("開始處理刪除商品請求 - 商品ID: " + productId + ", 操作者: " + userId);
        
        Map<String, Object> result = new HashMap<>();
        
        try {
            // 檢查商品是否存在
            if (!isProductExists(productId)) {
                result.put("success", false);
                result.put("message", "商品不存在");
                logger.warning("刪除商品失敗 - 商品不存在: " + productId);
                return result;
            }
            
            // 檢查操作權限（只有創建者或管理員可以刪除）
            if (!hasProductPermission(productId, userId)) {
                result.put("success", false);
                result.put("message", "沒有權限刪除此商品");
                logger.warning("刪除商品失敗 - 權限不足: 商品ID " + productId + ", 用戶ID " + userId);
                return result;
            }
            
            // 刪除商品相關圖片檔案
            deleteProductImages(productId);
            
            // 從資料庫刪除商品
            String deleteSQL = "DELETE FROM products WHERE product_id = ?";
            try (PreparedStatement pstmt = connection.prepareStatement(deleteSQL)) {
                pstmt.setInt(1, productId);
                
                int rowsAffected = pstmt.executeUpdate();
                
                if (rowsAffected > 0) {
                    result.put("success", true);
                    result.put("message", "商品刪除成功");
                    logger.info("商品刪除成功 - 商品ID: " + productId);
                } else {
                    result.put("success", false);
                    result.put("message", "商品刪除失敗");
                    logger.severe("商品刪除失敗 - 資料庫操作失敗");
                }
            }
            
        } catch (SQLException e) {
            // 記錄資料庫錯誤日誌
            logger.severe("刪除商品過程中發生資料庫錯誤: " + e.getMessage());
            result.put("success", false);
            result.put("message", "系統錯誤，請稍後再試");
        }
        
        return result;
    }
    
    /**
     * 獲取商品列表
     * @param categoryId 分類ID（可選）
     * @param status 商品狀態（可選）
     * @param page 頁碼
     * @param pageSize 每頁數量
     * @return 商品列表
     */
    public Map<String, Object> getProducts(Integer categoryId, String status, int page, int pageSize) {
        // 記錄獲取商品列表開始日誌
        logger.info("開始處理獲取商品列表請求 - 分類ID: " + categoryId + ", 狀態: " + status + ", 頁碼: " + page);
        
        Map<String, Object> result = new HashMap<>();
        List<Map<String, Object>> products = new ArrayList<>();
        
        try {
            // 構建查詢SQL
            StringBuilder sqlBuilder = new StringBuilder();
            sqlBuilder.append("SELECT p.*, c.category_name, u.username as created_by_username ");
            sqlBuilder.append("FROM products p ");
            sqlBuilder.append("LEFT JOIN categories c ON p.category_id = c.category_id ");
            sqlBuilder.append("LEFT JOIN users u ON p.created_by = u.user_id ");
            sqlBuilder.append("WHERE 1=1 ");
            
            List<Object> parameters = new ArrayList<>();
            
            // 添加分類篩選條件
            if (categoryId != null) {
                sqlBuilder.append("AND p.category_id = ? ");
                parameters.add(categoryId);
            }
            
            // 添加狀態篩選條件
            if (status != null && !status.isEmpty()) {
                sqlBuilder.append("AND p.status = ? ");
                parameters.add(status);
            }
            
            sqlBuilder.append("ORDER BY p.sort_order ASC, p.created_at DESC ");
            sqlBuilder.append("LIMIT ? OFFSET ? ");
            
            int offset = (page - 1) * pageSize;
            parameters.add(pageSize);
            parameters.add(offset);
            
            // 執行查詢
            try (PreparedStatement pstmt = connection.prepareStatement(sqlBuilder.toString())) {
                for (int i = 0; i < parameters.size(); i++) {
                    pstmt.setObject(i + 1, parameters.get(i));
                }
                
                try (ResultSet rs = pstmt.executeQuery()) {
                    while (rs.next()) {
                        Map<String, Object> product = new HashMap<>();
                        product.put("product_id", rs.getInt("product_id"));
                        product.put("product_name", rs.getString("product_name"));
                        product.put("description", rs.getString("description"));
                        product.put("price", rs.getBigDecimal("price"));
                        product.put("stock_quantity", rs.getInt("stock_quantity"));
                        product.put("category_name", rs.getString("category_name"));
                        product.put("main_image", rs.getString("main_image"));
                        product.put("status", rs.getString("status"));
                        product.put("weight", rs.getBigDecimal("weight"));
                        product.put("dimensions", rs.getString("dimensions"));
                        product.put("brand", rs.getString("brand"));
                        product.put("sku", rs.getString("sku"));
                        product.put("tags", rs.getString("tags"));
                        product.put("is_featured", rs.getBoolean("is_featured"));
                        product.put("created_by_username", rs.getString("created_by_username"));
                        product.put("created_at", rs.getTimestamp("created_at"));
                        product.put("updated_at", rs.getTimestamp("updated_at"));
                        
                        products.add(product);
                    }
                }
            }
            
            // 獲取總數量
            int totalCount = getProductCount(categoryId, status);
            
            result.put("success", true);
            result.put("products", products);
            result.put("total_count", totalCount);
            result.put("page", page);
            result.put("page_size", pageSize);
            result.put("total_pages", (int) Math.ceil((double) totalCount / pageSize));
            
            logger.info("商品列表獲取成功 - 返回 " + products.size() + " 個商品");
            
        } catch (SQLException e) {
            // 記錄資料庫錯誤日誌
            logger.severe("獲取商品列表過程中發生資料庫錯誤: " + e.getMessage());
            result.put("success", false);
            result.put("message", "系統錯誤，請稍後再試");
        }
        
        return result;
    }
    
