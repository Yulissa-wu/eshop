    /**
     * 檢查商品操作權限
     * @param productId 商品ID
     * @param userId 用戶ID
     * @return 是否有權限
     */
    private boolean hasProductPermission(int productId, int userId) throws SQLException {
        String selectSQL = "SELECT created_by FROM products WHERE product_id = ?";
        try (PreparedStatement pstmt = connection.prepareStatement(selectSQL)) {
            pstmt.setInt(1, productId);
            try (ResultSet rs = pstmt.executeQuery()) {
                if (rs.next()) {
                    int createdBy = rs.getInt("created_by");
                    return createdBy == userId || isAdmin(userId);
                }
            }
        }
        return false;
    }
    
    /**
