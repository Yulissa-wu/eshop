    /**
     * 用戶註冊功能
     * @param username 用戶名
     * @param email 電子郵件
     * @param password 密碼
     * @param role 用戶角色
     * @return 註冊結果
     */
    public Map<String, Object> registerUser(String username, String email, String password, String role) {
        // 記錄註冊開始日誌
        logger.info("開始處理用戶註冊請求 - 用戶名: " + username + ", 電子郵件: " + email);
        
        Map<String, Object> result = new HashMap<>();
        
        try {
            // 驗證輸入參數
            if (!validateRegistrationInput(username, email, password)) {
                result.put("success", false);
                result.put("message", "輸入資料格式不正確");
                logger.warning("註冊失敗 - 輸入資料格式不正確");
                return result;
            }
            
            // 檢查用戶名是否已存在
            if (isUsernameExists(username)) {
                result.put("success", false);
                result.put("message", "用戶名已存在");
                logger.warning("註冊失敗 - 用戶名已存在: " + username);
                return result;
            }
            
            // 檢查電子郵件是否已存在
            if (isEmailExists(email)) {
                result.put("success", false);
                result.put("message", "電子郵件已存在");
                logger.warning("註冊失敗 - 電子郵件已存在: " + email);
                return result;
            }
            
            // 加密密碼
            String hashedPassword = hashPassword(password);
            
            // 插入新用戶到資料庫
            String insertSQL = "INSERT INTO users (username, email, password_hash, role, status) VALUES (?, ?, ?, ?, 'active')";
            try (PreparedStatement pstmt = connection.prepareStatement(insertSQL)) {
                pstmt.setString(1, username);
                pstmt.setString(2, email);
                pstmt.setString(3, hashedPassword);
                pstmt.setString(4, role != null ? role : "user");
                
                int rowsAffected = pstmt.executeUpdate();
                
                if (rowsAffected > 0) {
                    result.put("success", true);
                    result.put("message", "註冊成功");
                    logger.info("用戶註冊成功 - 用戶名: " + username);
                } else {
                    result.put("success", false);
                    result.put("message", "註冊失敗");
                    logger.severe("註冊失敗 - 資料庫插入失敗");
                }
            }
            
        } catch (SQLException e) {
            // 記錄資料庫錯誤日誌
            logger.severe("註冊過程中發生資料庫錯誤: " + e.getMessage());
            result.put("success", false);
            result.put("message", "系統錯誤，請稍後再試");
        }
        
        return result;
    }
    
    /**
     * 用戶登錄功能
     * @param username 用戶名或電子郵件
     * @param password 密碼
     * @return 登錄結果
     */
    public Map<String, Object> loginUser(String username, String password) {
        // 記錄登錄開始日誌
        logger.info("開始處理用戶登錄請求 - 用戶名: " + username);
        
        Map<String, Object> result = new HashMap<>();
        
        try {
            // 查詢用戶資訊
            String selectSQL = "SELECT user_id, username, email, password_hash, role, status FROM users WHERE (username = ? OR email = ?) AND status = 'active'";
            try (PreparedStatement pstmt = connection.prepareStatement(selectSQL)) {
                pstmt.setString(1, username);
                pstmt.setString(2, username);
                
                try (ResultSet rs = pstmt.executeQuery()) {
                    if (rs.next()) {
                        // 驗證密碼
                        String storedPassword = rs.getString("password_hash");
                        if (verifyPassword(password, storedPassword)) {
                            // 登錄成功
                            result.put("success", true);
                            result.put("message", "登錄成功");
                            result.put("user_id", rs.getInt("user_id"));
                            result.put("username", rs.getString("username"));
                            result.put("email", rs.getString("email"));
                            result.put("role", rs.getString("role"));
                            
                            logger.info("用戶登錄成功 - 用戶名: " + username + ", 角色: " + rs.getString("role"));
                        } else {
                            // 密碼錯誤
                            result.put("success", false);
                            result.put("message", "密碼錯誤");
                            logger.warning("登錄失敗 - 密碼錯誤: " + username);
                        }
                    } else {
                        // 用戶不存在
                        result.put("success", false);
                        result.put("message", "用戶不存在或帳戶已停用");
                        logger.warning("登錄失敗 - 用戶不存在: " + username);
                    }
                }
            }
            
        } catch (SQLException e) {
            // 記錄資料庫錯誤日誌
            logger.severe("登錄過程中發生資料庫錯誤: " + e.getMessage());
            result.put("success", false);
            result.put("message", "系統錯誤，請稍後再試");
        }
        
        return result;
    }
    
