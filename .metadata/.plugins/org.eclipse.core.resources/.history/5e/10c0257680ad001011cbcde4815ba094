.wrap{
	width: 100%;
	height: 100vh;
	margin: 0 auto;  
}
.top-header,.top-footer{
	background: orange;
	text-align:center;
	line-height:100px;
}
.top-body{
	background:pink;
	text-align:center;
	line-height:300px;
}
.container {
  display: flex;
  flex-wrap: wrap; /* 允許換行 */
  gap: 10px;       /* item 間距 */
}

.item {
  width: calc((100% - 20px) / 3); /* 每行 3 個，減去間距 */
  background-color: #4CAF50;
  color: white;
  text-align: center;
  padding: 20px;
  box-sizing: border-box; /* 包含 padding 在寬度內 */
  height:500px;
}
