<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Add New Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
 	<link rel="stylesheet" href="resources/css/style2.css">
</head>
<body>
 	<div class="wrap">

  
    <div class="top-header"><img src="https://fs-f.ecimg.tw/img/h24/new/index/v1/images/logo/logo_pchome--24hWhiteMd-V2.svg" alt="Pchome" width="50" height="50"></div>
    <div class="top-body">    
    <div class=container>
    <div class=item><img src="https://img.pchome.com.tw/cs/items/DIBKVLA900HYUSA/000001_1760696339.jpg" alt="行李箱" width="300" height="300">
    <a href="http://localhost:8080/echop/product/product-detail">點我前往 Example 網站</a>
    </div> 
    <div class="item">Item2</div>
    <div class="item">Item3</div>
    <div class="item">Item4</div>  
    <div class="item">Item5</div> 
    <div class="item">Item6</div> 
    </div>
    <div class="top-footer">Footer欄位內容</div>
<div class="container mt-4">
    <h1>Add New Product</h1>

    <form th:action="@{/product/save}" th:object="${product}" method="post">
        <div class="mb-3">
            <label for="name" class="form-label">Product Name</label>
            <input type="text" th:field="*{name}" class="form-control" id="name" required>
        </div>
        <button type="submit" class="btn btn-success">Save</button>
        <a th:href="@{/product}" class="btn btn-secondary">Cancel</a>
    </form>
</div>
</body>
</html>

