<!DOCTYPE html>
<html lang="zh-TW" xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>貝蒂商城首頁</title>
<!-- 引入 Bootstrap CSS -->
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
	rel="stylesheet">
<link href="/css/style.css" rel="stylesheet">
<script src="../resources/js/cart.js"></script>
</head>
<body>
	<!-- ==================== 導覽列 ==================== -->
	<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
		<div class="container-fluid">
			<a class="navbar-brand" href="/">貝蒂商城</a>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav me-auto">
					<!-- 商品分類下拉選單 -->
					<li class="nav-item dropdown"><a
						class="nav-link dropdown-toggle" href="#" id="categoryDropdown"
						role="button" data-bs-toggle="dropdown" aria-expanded="false">
							商品分類 </a>
						<ul class="dropdown-menu" aria-labelledby="categoryDropdown">
							<li th:each="category : ${categories}"><a
								class="dropdown-item" th:text="${category.cate_name}"
								th:href="@{/product/category/{id}(id=${category.id})}"> </a></li>
						</ul></li>
				</ul>
				<!-- 登入 / 購物車 -->
				<ul class="navbar-nav">
					<ul class="navbar-nav">
						<!-- 如果使用者已登入 -->
						<li class="nav-item" th:if="${currentUser != null}"><span
							class="nav-link">歡迎, <b th:text="${currentUser.name}">使用者</b>
								登入中
						</span></li>
						<li class="nav-item" th:if="${currentUser != null}"><a
							class="nav-link" th:href="@{../auth/logout}">登出</a></li>

						<!-- 如果使用者未登入 -->
						<li class="nav-item" th:if="${currentUser == null}"><a
							class="nav-link" th:href="@{/auth/login}">登入</a></li>
						<li class="nav-item" th:if="${currentUser == null}"><a
							class="nav-link" th:href="@{/auth/register}">註冊</a></li>
					</ul>
					<li class="nav-item"><a class="nav-link" href="../cart/view">🛒
							購物車</a></li>
				</ul>
			</div>
		</div>
	</nav>

	<!-- ==================== 商品展示 ==================== -->
	<div class="container mt-4">
		<h2 class="text-center mb-4">精選商品</h2>
		<div class="row">
			<!-- 商品卡片（Thymeleaf 動態生成） -->
			<div class="col-md-3 mb-4" th:each="product : ${products}">
				<div class="card h-100 shadow-sm">
					<!-- 商品圖片 -->
					<!--  <img th:src="@{'/uploads/' + ${product.prod_image}}"-->
					<!--  class="card-img-top" alt="商品圖片">
					<img th:src="${product.prod_image}"
					class="card-img-top" alt="商品圖片">
					<div class="card-body">
						<h5 class="card-title" th:text="${product.prod_name}">商品名稱</h5>
						<p class="card-text text-danger fw-bold"
							th:text="'$' + ${product.prod_price}">價格</p>
						<a th:href="@{/products/productdetail/{id}(id=${product.id})}"
							class="btn btn-outline-primary btn-sm">查看詳情</a>
						<form th:action="@{/cart/add}" method="post" class="d-inline">
							<input type="hidden" name="productId" th:value="${product.id}" />
							<input type="hidden" name="quantity" value="1" />
							<button type="submit" class="btn btn-success btn-sm">加入購物車</button>
						</form>




					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ==================== 頁腳 ==================== -->
	<footer class="bg-dark text-white text-center py-3 mt-4">
		<p class="mb-0">&copy; 2025 貝蒂商城 | Powered by Spring Boot +
			Thymeleaf</p>
	</footer>

	<!-- JS -->
	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
