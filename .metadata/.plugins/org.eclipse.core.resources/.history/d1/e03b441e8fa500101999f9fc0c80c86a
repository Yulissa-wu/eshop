<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <title>商品詳細資料</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="container" id="productDetail"></div>

  <script>
    const products = [
      { id: 1, name: "運動手環", price: 1135, img: "https://via.placeholder.com/600x400", desc: "這款運動手環具備心率監測、睡眠追蹤、防水設計，適合運動與日常使用。" },
      { id: 2, name: "藍牙耳機", price: 2480, img: "https://via.placeholder.com/600x400", desc: "具備降噪功能與藍牙5.3連線技術，提供高音質與長時間續航。" },
      { id: 3, name: "智慧手錶", price: 3250, img: "https://via.placeholder.com/600x400", desc: "內建多種運動模式、血氧監測、訊息提醒等智慧功能。" },
      { id: 4, name: "運動耳機", price: 1500, img: "https://via.placeholder.com/600x400", desc: "運動專用，防汗設計" },
      { id: 5, name: "健身手環", price: 990, img: "https://via.placeholder.com/600x400", desc: "入門款健身手環，價格親民" }
    ];

    const params = new URLSearchParams(window.location.search);
    const id = parseInt(params.get('id'));
    const product = products.find(p => p.id === id);
    const detail = document.getElementById('productDetail');

    if (product) {
      detail.innerHTML = `
        <img src="${product.img}" alt="${product.name}">
        <h2>${product.name}</h2>
        <p class="price">$${product.price}</p>
        <p>${product.desc}</p>
        <a href="index.html" class="back">← 返回商品列表</a>
      `;
    } else {
      detail.innerHTML = `<p>找不到該商品。</p><a href="index.html" class="back">返回列表</a>`;
    }
  </script>
</body>
</html>
