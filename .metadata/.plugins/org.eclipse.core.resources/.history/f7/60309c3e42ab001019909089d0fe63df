<!DOCTYPE html>
<html lang="zh-TW" xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>產品管理系統</title>
<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container py-4">
	<h1 class="mb-4">產品管理系統Spring MVC</h1>
	<form th:action="@{/products}" method="post" th:object="${product}"
		class="card mb-4">
		<div class="card-header">
			<h5>新增產品</h5>
		</div>
		<div class="card-body">
			<div class="mb-3">
				<label class="form-label">產品名稱</label> <input type="text"
					class="form-control" th:field="*{name}" required>
			</div>
			<div class="mb-3">
				<label class="form-label">產品描述</label>
				<textarea class="form-control" th:field="*{description}"></textarea>
			</div>
			<div th:if="${#fields.hasErrors('price')}" class="text-danger">
			    <span th:errors="*{price}">錯誤</span>
			</div>
			<div class="mb-3">
				<label class="form-label">價格</label> <input type="number"
					class="form-control" th:field="*{price}" required>
			</div>
			<button type="submit" class="btn btn-primary">儲存</button>
		</div>
