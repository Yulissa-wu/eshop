-- =============================================
-- 創建視圖 (Views)
-- =============================================

-- 商品詳細資訊視圖
CREATE VIEW product_details AS
SELECT 
    p.product_id,
    p.product_name,
    p.description,
    p.price,
    p.stock_quantity,
    p.status,
    p.weight,
    p.dimensions,
    p.brand,
    p.sku,
    p.tags,
    p.is_featured,
    p.sort_order,
    p.created_at,
    p.updated_at,
    c.category_name,
    c.category_id,
    u.username as created_by_username,
    (SELECT image_path FROM product_images WHERE product_id = p.product_id AND is_main = TRUE LIMIT 1) as main_image
FROM products p
LEFT JOIN categories c ON p.category_id = c.category_id
LEFT JOIN users u ON p.created_by = u.user_id;

-- 商品圖片視圖
CREATE VIEW product_image_list AS
SELECT 
    pi.image_id,
    pi.product_id,
    pi.image_path,
    pi.image_description,
    pi.sort_order,
    pi.is_main,
    pi.created_at,
    p.product_name
FROM product_images pi
LEFT JOIN products p ON pi.product_id = p.product_id;

