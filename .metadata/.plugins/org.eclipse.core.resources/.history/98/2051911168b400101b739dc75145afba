<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>購物車</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
</head>
<body class="container py-4">
<h2>🛒 購物車</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>圖片</th>
            <th>名稱</th>
            <th>數量</th>
            <th>單價</th>
            <th>小計</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        <tr th:each="item : ${cart}">
            <td><img th:src="@{'/uploads/' + ${item.image}}" width="80"></td>
            <td th:text="${item.name}"></td>
            <td th:text="${item.quantity}"></td>
            <td th:text="'$' + ${item.price}"></td>
            <td th:text="'$' + ${item.price * item.quantity}"></td>
            <td>
                <a th:href="@{/cart/remove/{id}(id=${item.id})}" class="btn btn-danger btn-sm">移除</a>
            </td>
        </tr>
    </tbody>
</table>

<h4>總金額：<span th:text="'$' + ${total}"></span></h4>

<a href="/cart/clear" class="btn btn-warning">清空購物車</a>
<a href="/product" class="btn btn-secondary">繼續購物</a>
<a href="#" class="btn btn-success">結帳</a>

</body>
</html>
