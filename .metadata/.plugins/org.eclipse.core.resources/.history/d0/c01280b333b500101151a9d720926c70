<!DOCTYPE html>
<html lang="zh-TW" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>註冊帳號</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container mt-5">
    <div class="card shadow mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <h3 class="text-center mb-3">註冊帳號</h3>
            <form action="/auth/register" method="post">
                <div class="mb-3">
                    <label for="email" class="form-label">電子郵件</label>
                    <input type="email" class="form-control" id="email" name="email" required placeholder="輸入 email">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">密碼</label>
                    <input type="password" class="form-control" id="password" name="password" required
                           pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}"
                           title="至少 8 字元，包含大小寫、數字與符號">
                </div>
                <button type="submit" class="btn btn-primary w-100">註冊</button>
                <div th:if="${error}" class="text-danger mt-2" th:text="${error}"></div>
            </form>
            <div class="text-center mt-3">
                <a href="/auth/login">已有帳號？登入</a>
            </div>
        </div>
    </div>
</div>
</body>
</html>
