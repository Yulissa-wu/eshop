/* LOG: 開始商品列表樣式 */
body {
    font-family: Arial, sans-serif;
    margin: 20px;
}

h1 {
    color: #333;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

table, th, td {
    border: 1px solid #ccc;
}

th, td {
    padding: 10px;
    text-align: center;
}

.btn-add {
    display: inline-block;
    margin-bottom: 10px;
    padding: 8px 12px;
    background-color: #4CAF50;
    color: white;
    text-decoration: none;
}

.btn-view {
    background-color: #2196F3;
    color: white;
    padding: 5px 8px;
    text-decoration: none;
}

.btn-edit {
    background-color: #FFC107;
    color: white;
    padding: 5px 8px;
    text-decoration: none;
}

.btn-delete {
    background-color: #F44336;
    color: white;
    padding: 5px 8px;
    text-decoration: none;
}
