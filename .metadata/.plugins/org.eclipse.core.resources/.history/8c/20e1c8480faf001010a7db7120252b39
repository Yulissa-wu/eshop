<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Edit Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-4">
    <h1>Edit Product</h1>
    <form th:action="@{/products/update/{id}(id=${product.id})}" th:object="${product}" method="post">
        <div class="mb-3">
            <label>ID</label>
            <input type="text" th:value="${product.id}" class="form-control" readonly>
        </div>
                <div class="mb-3">
            <label>Name</label>
            <input type="text" th:field="*{product.prod_num}" class="form-control" required>
        </div>
        <div class="mb-3">
            <label>Name</label>
            <input type="text" th:field="*{product.prod_name}" class="form-control" required>
        </div>
        <div class="mb-3">
            <label>Email</label>
            <input type="email" th:field="*{product.prod_type}" class="form-control" required>
        </div>
                <div class="mb-3">
            <label>Email</label>
            <input type="email" th:field="*{product.prod_line}" class="form-control" required>
        </div>
                <div class="mb-3">
            <label>Email</label>
            <input type="email" th:field="*{product.pro_price}" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-warning">Update</button>
        <a th:href="@{/product}" class="btn btn-secondary">Cancel</a>
    </form>
</div>
</body>
</html>
