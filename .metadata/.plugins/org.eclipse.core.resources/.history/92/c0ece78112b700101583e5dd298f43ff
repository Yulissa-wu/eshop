@Service
@Transactional
public class CartItemServiceImpl implements CartItemService {

	@Autowired
    private CartDAO CartDAO;
    
    @Autowired
    private CartItemDAO CartItemDAO;
    

        
    @Override
    public List<CartItem> getAllCartItems() {
        return CartItemDAO.findAll();
    }

 
    @Override
    public CartItem getCartItemById(Long id) {
        return CartItemDAO.findById(id);
    }

    @Override
    public void saveCartItem(CartItem cartItem) {
    	CartItemDAO.save(cartItem);
    }

    @Override
    public void updateCartItem(Long id, CartItem updatedCart) {
    	CartItem existingCart = CartItemDAO.findById(id);
        if (existingCart != null) {
//            existingCart.setCart_name(updatedCart.getCart_name());
//            existingCart.setCart_price(updatedCart.getCart_price());
        	CartItemDAO.save(existingCart);
        }
    }

    @Override
    public void deleteCartItem(Long id) {
    	CartItemDAO.delete(id);
    }

}
