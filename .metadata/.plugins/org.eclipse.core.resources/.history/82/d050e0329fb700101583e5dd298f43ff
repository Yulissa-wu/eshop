package com.example.demo.controller;

import com.example.demo.model.Product;
import com.example.demo.model.CartItem;
import com.example.demo.service.ProductService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;

import javax.servlet.http.HttpSession;
import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.List;

@Controller
@RequestMapping("/cart")
public class CartController {

    @Autowired
    private ProductService productService;

    // 🛒 顯示購物車內容
    @GetMapping
    public String viewCart(HttpSession session, Model model) {
        // 加入購物車
        @PostMapping("/add{id}")
        public String addToCart(@RequestParam("productId") Long productId,
                                @RequestParam("quantity") int quantity,
                                HttpSession session) {

            // 1️⃣ 取得目前使用者
            Customer customer = (Customer) session.getAttribute("currentUser");
            if (customer == null) {
                return "redirect:/login"; // 尚未登入
            }

            // 2️⃣ Session 中的購物車 (暫存)
            List<CartItem> cart = (List<CartItem>) session.getAttribute("cart");
            if (cart == null) {
                cart = new ArrayList<>();
            }

            // 3️⃣ 加入商品到暫存購物車
            CartItem item = new CartItem();
            Product product = cartService.findProductById(productId);
            item.setProduct(product);
            item.setQuantity(quantity);
            cart.add(item);
            session.setAttribute("cart", cart); // 更新 Session 購物車

            // 4️⃣ 同步寫入資料庫
            cartService.addProductToCart(customer, product, quantity);

            return "redirect:/cart/view";
        }

        // 顯示購物車
        @GetMapping("/view")
        public String viewCart(HttpSession session, Model model) {
            Customer customer = (Customer) session.getAttribute("currentUser");
            if (customer == null) {
                return "redirect:/login";
            }

            // 從 Session 取暫存購物車
            List<CartItem> cart = (List<CartItem>) session.getAttribute("cart");
            model.addAttribute("sessionCart", cart);

            // 從資料庫查購物車
            Cart dbCart = cartService.getCartByCustomer(customer);
            model.addAttribute("dbCart", dbCart);

            return "cart"; // 對應 cart.html
        }
    }
    // ✏️ 更新數量
    @PostMapping("/update/{id}")
    public String updateQuantity(@PathVariable("id") Long id,
                                 @RequestParam("quantity") int quantity,
                                 HttpSession session) {
        List<CartItem> cartItems = (List<CartItem>) session.getAttribute("cartItems");
        if (cartItems != null) {
            for (CartItem item : cartItems) {
                if (item.getProduct().getId().equals(id)) {
                    item.setQuantity(quantity);
                    break;
                }
            }
        }
        session.setAttribute("cartItems", cartItems);
        return "redirect:/cart";
    }

    // ❌ 移除項目
    @GetMapping("/remove/{id}")
    public String removeFromCart(@PathVariable("id") Long id, HttpSession session) {
        List<CartItem> cartItems = (List<CartItem>) session.getAttribute("cartItems");
        if (cartItems != null) {
            cartItems.removeIf(item -> item.getProduct().getId().equals(id));
        }
        session.setAttribute("cartItems", cartItems);
        return "redirect:/cart";
    }

    // 🧹 清空購物車
    @GetMapping("/clear")
    public String clearCart(HttpSession session) {
        session.removeAttribute("cartItems");
        return "redirect:/cart";
    }
}
