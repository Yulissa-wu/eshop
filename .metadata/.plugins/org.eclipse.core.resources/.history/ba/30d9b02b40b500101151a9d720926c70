package com.example.demo.controller;

import com.example.demo.model.Cart;
import com.example.demo.service.CartService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;

@Controller
@RequestMapping("/cart")
public class CartController {
    
    @Autowired
    private CartService cartService;
    
    @GetMapping
    public String listCart(Model model) {
        model.addAttribute("cart", cartService.getAllCart());
        return "cart";
    }
    
    @GetMapping("/add")
    public String showAddForm(Model model) {
        model.addAttribute("cart", new Cart());
        return "add-cart";
    }
    
    @GetMapping("/edit/{id}")
    public String showEditForm(@PathVariable("id") Long id, Model model) {
    	Cart cart = cartService.getCartById(id);
        model.addAttribute("cart", cart);
        return "edit-cart"; // 對應 /WEB-INF/views/edit-cart.html
    }
    
    @PostMapping("/update/{id}")
    public String updateCart(@PathVariable("id") Long id, @ModelAttribute("cart") Cart cart) {
    	cartService.updateCart(id, cart);
        return "redirect:/cart";
    }
    
    @PostMapping("/save")
    public String saveCart(@ModelAttribute Cart cart) {
    	cartService.saveCart(cart);
        return "redirect:/cart";
    }
    
    @GetMapping("/delete/{id}")
    public String deleteCart(@PathVariable("id") Long id) {
    	cartService.deleteCart(id);
        return "redirect:/cart";
    }
}