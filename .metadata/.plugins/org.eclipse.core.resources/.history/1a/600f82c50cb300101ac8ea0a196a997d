<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>商品列表</title>
    <!-- Bootstrap CSS CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- 自訂 CSS -->
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/style.css">
</head>
<body>
<div class="container mt-4">

    <h1 class="mb-4">商品列表</h1>

    <!-- 顯示登入狀態 -->
    <c:choose>
        <c:when test="${not empty sessionScope.email}">
            <p>歡迎, ${sessionScope.fullName} 
            <c:if test="${sessionScope.role == 'ROLE_ADMIN'}">(管理員)</c:if>
            </p>
        </c:when>
        <c:otherwise>
            <p><a href="${pageContext.request.contextPath}/customers/login">登入</a> 或 
               <a href="${pageContext.request.contextPath}/customers/register">註冊</a>
            </p>
        </c:otherwise>
    </c:choose>

    <!-- 管理員新增商品按鈕 -->
    <c:if test="${sessionScope.role == 'ROLE_ADMIN'}">
        <a href="${pageContext.request.contextPath}/products/admin/add" class="btn btn-success mb-3">新增商品</a>
    </c:if>

    <!-- 商品列表 -->
    <div class="row">
        <c:forEach var="product" items="${products}">
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <!-- 商品圖片 -->
                    <img src="${pageContext.request.contextPath}/${product.imagePath}" class="card-img-top" alt="${product.name}">
                    
                    <div class="card-body">
                        <!-- 商品名稱 -->
                        <h5 class="card-title">${product.name}</h5>
                        <!-- 商品價格 -->
                        <p class="card-text">價格: NT$ ${product.price}</p>
                        <!-- 商品庫存 -->
                        <p class="card-text">庫存: ${product.stock}</p>
                        <!-- 查看詳細頁按鈕 -->
                        <a href="${pageContext.request.contextPath}/products/detail/${product.prodId}" class="btn btn-primary">查看詳細</a>

                        <!-- 加入購物車按鈕 (前端表單) -->
                        <form action="${pageContext.request.contextPath}/cart/add" method="post" class="mt-2">
                            <input type="hidden" name="prodId" value="${product.prodId}">
                            <input type="number" name="quantity" value="1" min="1" max="${product.stock}" class="form-control mb-1">
                            <button type="submit" class="btn btn-warning w-100">加入購物車</button>
                        </form>

                        <!-- 管理員操作按鈕 -->
                        <c:if test="${sessionScope.role == 'ROLE_ADMIN'}">
                            <a href="${pageContext.request.contextPath}/products/admin/delete/${product.prodId}" 
                               class="btn btn-danger mt-2 w-100"
                               onclick="return confirm('確定要刪除這個商品嗎？');">刪除商品</a>
                        </c:if>
                    </div>
                </div>
            </div>
        </c:forEach>
    </div>

</div>

<!-- Bootstrap JS CDN -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- 自訂 JS -->
<script src="${pageContext.request.contextPath}/resources/js/script.js"></script>
</body>
</html>
