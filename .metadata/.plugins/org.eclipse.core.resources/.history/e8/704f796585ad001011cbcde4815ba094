.wrap{
	width: 100%;
	height: 100vh;
	margin: 0 auto;  
}
.top-header,.top-footer{
	background: orange;
	text-align:center;
	line-height:100px;
}
.top-body{
	background:pink;
	text-align:center;
	line-height:300px;
}
.container {
  display: flex;
  flex-wrap: wrap; /* 允許換行 */
  gap: 10px;       /* item 間距 */
  padding: 30px;
}

.item {
  text-align: center;
  background-color: #4CAF50;
  color: white;
  padding: 20px;
  box-sizing: border-box;
  border-radius: 10px;
  width: calc((100% - 20px) / 3);
}

.item img {
  display: block;        /* 拿掉底部空隙 */
  margin: 0 auto;        /* 水平置中 */
  width: 300px;
  height: 300px;
  border-radius: 8px;
  margin-bottom: 5px;    /* 與連結距離微小 */
}

.item a {
  display: inline-block;
  text-decoration: none;
  color: #007bff;
  font-weight: bold;
  margin-top: 0;         /* 不要額外間距 */
}


