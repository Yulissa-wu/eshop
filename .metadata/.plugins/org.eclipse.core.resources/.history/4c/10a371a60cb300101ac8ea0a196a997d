package com.example.demo.controller;

import com.example.demo.model.Product;
import com.example.demo.dao.ProductDAO;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.io.File;
import java.io.IOException;
import java.util.List;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.security.access.prepost.PreAuthorize;

/**
 * ProductController
 * 主要功能：
 * - 顯示商品列表
 * - 顯示商品詳細頁
 * - 管理員新增 / 刪除商品及圖片（使用 Spring Security 註解保護）
 */
@Controller
@RequestMapping("/products")
public class ProductController {

    private final Logger logger = LoggerFactory.getLogger(ProductController.class);

    @Autowired
    private ProductDAO productDAO;

    // -------------------------------
    // 顯示商品列表頁
    // -------------------------------
    @GetMapping("/list")
    public String listProducts(Model model) {
        List<Product> products = productDAO.getAllProducts();
        model.addAttribute("products", products);
        logger.info("列出所有商品，總數: {}", products.size());
        return "product-list";
    }

    // -------------------------------
    // 顯示單一商品詳細頁
    // -------------------------------
    @GetMapping("/detail/{id}")
    public String productDetail(@PathVariable("id") int id, Model model) {
        Product product = productDAO.getProductById(id);
        if (product == null) {
            logger.warn("找不到商品 id={}", id);
            return "redirect:/products/list";
        }
        model.addAttribute("product", product);
        logger.info("查看商品詳細頁 id={}", id);
        return "product-detail";
    }

    // -------------------------------
    // 管理員新增商品頁（GET）
    // -------------------------------
    @PreAuthorize("hasRole('ADMIN')")
    @GetMapping("/admin/add")
    public String addProductForm() {
        return "admin-add-product"; // JSP 表單頁
    }

    // -------------------------------
    // 管理員新增商品處理（POST）
    // -------------------------------
    @PreAuthorize("hasRole('ADMIN')")
    @PostMapping("/admin/add")
    public String addProduct(
            @RequestParam("name") String name,
            @RequestParam("description") String description,
            @RequestParam("price") double price,
            @RequestParam("stock") int stock,
            @RequestParam("imageFile") MultipartFile imageFile
    ) {
        Product product = new Product();
        product.setName(name);
        product.setDescription(description);
        product.setPrice(price);
        product.setStock(stock);

        // 處理圖片上傳
        if (!imageFile.isEmpty()) {
            try {
                String uploadDir = "src/main/webapp/uploads/";
                File dir = new File(uploadDir);
                if (!dir.exists()) dir.mkdirs();

                String fileName = System.currentTimeMillis() + "_" + imageFile.getOriginalFilename();
                File dest = new File(uploadDir + fileName);
                imageFile.transferTo(dest);

                product.setImagePath("uploads/" + fileName);
                logger.info("圖片上傳成功: {}", fileName);
            } catch (IOException e) {
                logger.error("圖片上傳失敗", e);
            }
        }

        productDAO.addProduct(product);
        logger.info("新增商品成功: {}", name);
        return "redirect:/products/list";
    }

    // -------------------------------
    // 管理員刪除商品
    // -------------------------------
    @PreAuthorize("hasRole('ADMIN')")
    @GetMapping("/admin/delete/{id}")
    public String deleteProduct(@PathVariable("id") int id) {
        Product product = productDAO.getProductById(id);
        if (product != null && product.getImagePath() != null) {
            File img = new File("src/main/webapp/" + product.getImagePath());
            if (img.exists() && img.delete()) {
                logger.info("刪除商品圖片成功: {}", product.getImagePath());
            }
        }

        productDAO.deleteProduct(id);
        logger.info("刪除商品成功 id={}", id);
        return "redirect:/products/list";
    }
}
