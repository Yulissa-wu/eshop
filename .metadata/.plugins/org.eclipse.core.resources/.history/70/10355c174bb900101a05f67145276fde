	@Transactional
    public void deleteCartItem(Long cartItemId) {
        CartItem item = CartItemDAO.findById(cartItemId);
        if (item != null) {
            Cart cart = item.getCart();
            if (cart != null && cart.getItems() != null) {
                cart.getItems().remove(item); // 移除集合
            }
            CartItemDAO.delete(cartItemId); // 刪除資料庫
        }
        @Override
        @Transactional
        public void deleteCart(Long cartId) {
            // 1️⃣ 從資料庫撈出 Cart
            Cart cart = CartDAO.findById(cartId);
            if (cart != null) {
                // 2️⃣ 先刪除 Cart 底下所有 CartItem，避免 cascade 衝突
                if (cart.getItems() != null) {
                    for (CartItem item : cart.getItems()) {
                        CartItemDAO.delete(item.getId()); // 逐一刪除 CartItem
                    }
                    cart.getItems().clear();
                }

                // 3️⃣ 刪除 Cart
                CartDAO.delete(cartId); // DAO 內用 EntityManager 或 Hibernate 刪除資料庫
            }
        }

        
        
    }


