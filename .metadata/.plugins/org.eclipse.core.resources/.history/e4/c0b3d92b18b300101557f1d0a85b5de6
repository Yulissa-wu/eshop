package com.example.demo.service;

import com.example.demo.model.Product;
import com.example.demo.dao.ProductDAO;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;

import java.util.List;

/**
 * 商品控制器
 * 提供頁面操作商品的功能
 */
@Controller
@RequestMapping("/products")
public class ProductController {

    @Autowired
    private ProductDAO productDAO;

    // ==============================
    // 顯示商品列表頁面
    // ==============================
    @GetMapping
    public String listProducts(Model model) {
        System.out.println("[LOG] 顯示商品列表頁面");
        List<Product> products = productDAO.getAllProducts();
        model.addAttribute("products", products);
        model.addAttribute("pageTitle", "商品列表");
        return "products"; // 對應 /WEB-INF/views/products.html
    }

    // ==============================
    // 顯示新增商品頁面
    // ==============================
    @GetMapping("/add")
    public String showAddProductForm(Model model) {
        System.out.println("[LOG] 顯示新增商品頁面");
        model.addAttribute("product", new Product());
        model.addAttribute("pageTitle", "新增商品");
        return "product-form"; // 對應 /WEB-INF/views/product-form.html
    }

    // ==============================
    // 處理新增商品提交
    // ==============================
    @PostMapping("/add")
    public String addProduct(@ModelAttribute Product product) {
        System.out.println("[LOG] 提交新增商品: " + product.getProductName());
        productDAO.addProduct(product);
        return "redirect:/products"; // 新增成功後回到商品列表
    }

    // ==============================
    // 顯示修改商品頁面
    // ==============================
    @GetMapping("/edit/{id}")
    public String showEditProductForm(@PathVariable("id") int id, Model model) {
        System.out.println("[LOG] 顯示修改商品頁面, ID=" + id);
        Product product = productDAO.getProductById(id);
        model.addAttribute("product", product);
        model.addAttribute("pageTitle", "修改商品");
        return "product-form"; // 可與新增共用 form
    }

    // ==============================
    // 處理修改商品提交
    // ==============================
    @PostMapping("/edit")
    public String editProduct(@ModelAttribute Product product) {
        System.out.println("[LOG] 提交修改商品: " + product.getProductId());
        productDAO.updateProduct(product);
        return "redirect:/products"; // 修改成功後回到商品列表
    }

    // ==============================
    // 刪除商品
    // ==============================
    @GetMapping("/delete/{id}")
    public String deleteProduct(@PathVariable("id") int id) {
        System.out.println("[LOG] 刪除商品, ID=" + id);
        productDAO.deleteProduct(id);
        return "redirect:/products"; // 刪除後回到商品列表
    }

    // ==============================
    // 顯示商品詳細頁
    // ==============================
    @GetMapping("/{id}")
    public String viewProduct(@PathVariable("id") int id, Model model) {
        System.out.println("[LOG] 顯示商品詳細頁, ID=" + id);
        Product product = productDAO.getProductById(id);
        model.addAttribute("product", product);
        model.addAttribute("pageTitle", "商品詳細");
        return "product-detail"; // 對應 /WEB-INF/views/product-detail.html
    }
}
