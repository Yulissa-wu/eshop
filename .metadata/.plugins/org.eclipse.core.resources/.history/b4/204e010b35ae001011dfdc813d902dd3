package com.example.demo.controller;

import com.example.demo.model.Product;
import com.example.demo.service.ProductService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;

@Controller
@RequestMapping("/product")
public class ProductController {
    
    @Autowired
    private ProductService productService;
    
    @GetMapping("/product-detail")
    public String productDetail(@RequestParam("prod_num") int prod_num, Model model) {
        System.out.println("進入 product-detail，prod_num=" + prod_num);
        Product product = productService.getProductById(prod_num);
        System.out.println("查詢結果：" + product);
        model.addAttribute("product", product);
        return "product-detail"; // 對應 templates/product-detail.html
    }
    
    @GetMapping
    public String listProduct(Model model) {
        model.addAttribute("products",productService.getAllProduct());
        return "product";
    }
    
    @GetMapping("/add")
    public String showAddForm(Model model) {
        model.addAttribute("product", new Product());
        return "add-product";
    }
    
    @GetMapping("/edit/{id}")
    public String showEditForm(@PathVariable("prod_num") int prod_num, Model model) {
    	Product product = productService.getProductById(prod_num);
        model.addAttribute("product", product);
        return "edit-product"; // 對應 /WEB-INF/views/edit-user.html
    }
    
    @PostMapping("/update/{id}")
    public String updateUser(@PathVariable("id") int id, @ModelAttribute("Product") Product product) {
    	productService.updateProduct(id, product);
        return "redirect:/product";
    }
    
    @PostMapping("/save")
    public String Product(@ModelAttribute Product product) {
    	productService.saveProduct(product);
        return "redirect:/product";
    }
    
    @GetMapping("/delete/{id}")
    public String deleteProduct(@PathVariable("prod_num") int prod_num) {
    	productService.deleteProduct(prod_num);
        return "redirect:/product";
    }
}